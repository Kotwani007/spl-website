<%- include('../partials/header') %>
<section class="page-hero match-centre-hero"><p class="eyebrow">FIXTURES · LIVE SCORES · RESULTS</p><h1>Match <em>Centre</em></h1><p class="lead">Every fixture, every result and every live moment from the Sindhi Premier League.</p></section>
<section class="section match-centre-section"><div class="section-head"><div><p class="eyebrow">ON THE FIELD</p><h2>Live matches</h2></div><% if(user.is_staff){ %><a class="btn btn-gold" href="/matches/start/">＋ Start a match</a><% } %></div>
<% if(live_matches.length){ %><div class="live-match-grid"><% live_matches.forEach(match=>{ %><a class="live-match-card" href="/matches/<%= match.id %>/"><div class="live-pill"><i></i> LIVE NOW <span>SEASON <%= match.tournament.season %></span></div><div class="live-teams"><b><%= match.team_a.name %></b><span>VS</span><b><%= match.team_b.name %></b></div><p><%= match.stage %> · <%= match.ground||'Ulhasnagar' %></p><strong>Open live score →</strong></a><% }) %></div><% }else{ %><div class="no-live-card"><div class="live-ball-art">SPL</div><div><p class="eyebrow">NO MATCH IN PROGRESS</p><h3>The pitch is ready.</h3><p>Live scores will appear here when an organiser starts a match.</p></div><% if(user.is_staff){ %><a class="btn btn-gold" href="/matches/start/">Start a match</a><% } %></div><% } %>
<div class="section-head fixture-heading"><div><p class="eyebrow">SEASON ARCHIVE</p><h2>Fixtures & results</h2></div></div><form class="filter-bar" method="get"><label>Season <select name="season"><option value="">All seasons</option><% seasons.forEach(s=>{ %><option value="<%= s.season %>"<%= Number(selectedSeason)===s.season?' selected':'' %>>Season <%= s.season %></option><% }) %></select></label><label>Team search <input name="q" value="<%= search %>" placeholder="Search a team"></label><button class="btn btn-gold">Search</button></form><div class="match-list"><% if(matches.length){matches.forEach(match=>{ %><a class="match-card" href="/matches/<%= match.id %>/"><div class="match-meta\"><span>SEASON <%= match.tournament.season %></span><span><%= match.stage||'League match' %></span><span><%= date(match.date) %></span><span class="status-label status-<%= match.status %>"><%= statusLabel(match.status) %></span></div><div class="match-teams"><b><%= match.team_a.name %></b><span>VS</span><b><%= match.team_b.name %></b></div><div class="match-result"><%= match.status==='completed'?(match.result_text||'Result not entered'):statusLabel(match.status) %></div></a><% })}else{ %><div class="empty-state">No matches found. Add match records in the organiser admin.</div><% } %></div></section>
<%- include('../partials/footer') %>
