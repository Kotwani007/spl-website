<%- include('../partials/header') %>
<section class="page-hero organiser-auction-hero"><div class="container"><p class="eyebrow">ORGANISED PLAYER AUCTION</p><h1>Build the auction room.</h1><p class="lead">Manage categories, player eligibility, team purses, the queue and the live bidding desk.</p><div class="actions"><a class="btn btn-light" href="/auction/">View public auction</a><a class="btn btn-outline" href="/organiser/">Organiser desk</a></div></div></section>
<section class="container section organiser-auction-page">
<section class="auction-panel"><div class="section-head"><div><p class="eyebrow">AUCTION CATEGORIES</p><h2>Base prices and groups.</h2></div><span><%= categories.length %> categories</span></div><form method="post" class="auction-admin-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="category_save"><label>Name<input name="name" maxlength="80" required placeholder="Category name"></label><label>Description<input name="description" maxlength="240" placeholder="Short description"></label><label>Base price (₹)<input type="number" name="base_price" min="0" step="1" required value="0"></label><label>Order<input type="number" name="position" min="0" value="0"></label><button class="btn" type="submit">Add category</button></form>
<% if(categories.length){ %><div class="table-wrap"><table class="score-table"><thead><tr><th>Category</th><th>Description</th><th>Base price</th><th>Order</th><th>Actions</th></tr></thead><tbody><% categories.forEach(c=>{ %><tr><td class="name-cell"><form method="post" class="auction-admin-inline"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="category_save"><input type="hidden" name="category_id" value="<%= c.id %>"><input name="name" value="<%= c.name %>" maxlength="80" required></td><td><input name="description" value="<%= c.description %>" maxlength="240"></td><td><input type="number" name="base_price" min="0" value="<%= c.base_price %>"></td><td><input type="number" name="position" min="0" value="<%= c.position %>"></td><td><button class="btn btn-outline" type="submit">Save</button></form><form method="post" class="inline-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="category_delete"><input type="hidden" name="category_id" value="<%= c.id %>"><button class="text-link" type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div><% } %></section>

<section class="auction-panel"><div class="section-head"><div><p class="eyebrow">PLAYER POOL</p><h2>Prepare the line-up.</h2></div><span><%= players.length %> player records</span></div><form method="post" class="auction-admin-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="player_create"><label>Player name<input name="name" maxlength="120" required></label><label>City<input name="city" maxlength="100"></label><label>Category<select name="auction_category"><option value="">No category</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %> · ₹<%= inr(c.base_price) %></option><% }) %></select></label><label>Individual base price (₹)<input type="number" name="auction_base_price" min="0" step="1"></label><label class="check-label"><input type="checkbox" name="is_marquee" value="true"> Marquee player</label><label class="check-label"><input type="checkbox" name="in_auction_pool" value="true" checked> Include in auction pool</label><button class="btn" type="submit">Add player</button></form>
<details class="filter-panel"><summary>Review and edit player records</summary><div class="auction-player-admin-list"><% players.slice(0,80).forEach(p=>{ %><form method="post" class="auction-player-admin-row"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="player_save"><input type="hidden" name="player_id" value="<%= p.id %>"><label>Player<input name="name" value="<%= p.name %>" required></label><label>City<input name="city" value="<%= p.city %>"></label><label>Category<select name="auction_category"><option value="">No category</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"<%= p.auction_category_id===c.id?' selected':'' %>><%= c.name %></option><% }) %></select></label><label>Base price<input type="number" name="auction_base_price" min="0" value="<%= p.auction_base_price ?? '' %>"></label><label class="check-label"><input type="checkbox" name="is_marquee" value="true"<%= p.is_marquee?' checked':'' %>> Marquee</label><label class="check-label"><input type="checkbox" name="in_auction_pool" value="true"<%= p.in_auction_pool?' checked':'' %>> In pool</label><button class="btn btn-outline" type="submit">Save player</button></form><% }) %></div><% if(players.length>80){ %><p class="form-note">Showing 80 of <%= players.length %> player entries; use the name search in the public Players page to locate profiles.</p><% } %></details></section>

<section class="auction-panel"><div class="section-head"><div><p class="eyebrow">CREATE AN AUCTION</p><h2>Set the rules and queue.</h2></div><span><%= auctions.length %> saved auctions</span></div><form method="post" class="auction-create-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="auction_create"><label>Auction name<input name="name" maxlength="150" required placeholder="Season auction"></label><label>Season<select name="tournament" required><option value="">Select season</option><% tournaments.forEach(t=>{ %><option value="<%= t.id %>">Season <%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Bid increment (₹)<input type="number" name="bid_increment" min="1" value="100000" required></label><label>Starting purse per team (₹)<input type="number" name="team_budget" min="1" value="10000000" required></label><label class="full">Select auction pool players <select name="players" multiple size="10" required><% players.filter(p=>p.is_active&&p.in_auction_pool).forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> · <%= p.category_name||'Uncategorised' %> · ₹<%= inr(p.auction_base_price??p.category_base_price??0) %></option><% }) %></select></label><p class="form-note full">Use Ctrl or Command to select several players. Each selected player needs a category price or an individual base price.</p><button class="btn" type="submit">Create auction queue</button></form></section>

<section class="auction-panel"><div class="section-head"><div><p class="eyebrow">SAVED AUCTIONS</p><h2>Auction controls.</h2></div><% if(auctions.length){ %><span><%= auctions.length %> total</span><% } %></div><% if(auctions.length){ %><form method="get" class="filter-bar"><label for="auction-select">Choose auction<select id="auction-select" name="auction"><% auctions.forEach(a=>{ %><option value="<%= a.id %>"<%= selectedAuction?.id===a.id?' selected':'' %>><%= a.name %> · Season <%= a.season %> · <%= statusLabel(a.status) %></option><% }) %></select></label><button class="btn" type="submit">Open controls</button></form><% }else{ %><div class="empty-state"><p>Create the first auction after preparing players for the pool.</p></div><% } %>
<% if(selectedAuction&&auction){ %><div class="auction-selected-summary"><p class="eyebrow">SELECTED AUCTION · SEASON <%= auction.season %></p><h3><%= auction.name %></h3><p>Status: <strong><%= auction.status_display %></strong> · Increment ₹<%= inr(auction.bid_increment) %></p><div class="actions"><% if(['draft','ready'].includes(auction.status)){ %><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="start"><input type="hidden" name="auction_id" value="<%= auction.id %>"><button class="btn" type="submit">Start auction</button></form><% }else if(auction.status==='running'){ %><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="pause"><input type="hidden" name="auction_id" value="<%= auction.id %>"><button class="btn btn-outline" type="submit">Pause</button></form><% }else if(auction.status==='paused'){ %><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="resume"><input type="hidden" name="auction_id" value="<%= auction.id %>"><button class="btn" type="submit">Resume</button></form><% } %><a class="btn btn-outline" href="/auction/">Open public page</a></div></div>
<% if(['draft','ready'].includes(auction.status)){ %><div class="two-col"><form method="post" class="start-match-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="increment_save"><input type="hidden" name="auction_id" value="<%= auction.id %>"><label>Bid increment (₹)<input type="number" name="bid_increment" min="1" value="<%= auction.bid_increment %>" required></label><button class="btn btn-outline" type="submit">Save increment</button></form><div><h3>Team purses</h3><% team_purses.forEach(p=>{ %><form method="post" class="auction-admin-inline"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="purse_save"><input type="hidden" name="auction_id" value="<%= auction.id %>"><input type="hidden" name="purse_id" value="<%= p.id %>"><label><%= p.team.name %> · spent ₹<%= inr(p.spent) %><input type="number" name="budget" min="<%= p.spent %>" value="<%= p.budget %>"></label><button class="btn btn-outline" type="submit">Save purse</button></form><% }) %></div></div><% } %>
<% if(current_lot){ %><div class="auction-current-control"><p class="eyebrow">ON THE BLOCK</p><h3><%= current_lot.player.name %> · Base ₹<%= inr(current_lot.base_price) %></h3><% if(auction.status==='running'){ %><form method="post" class="auction-admin-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="bid"><input type="hidden" name="idempotencyKey" value="<%= auctionNonce %>"><input type="hidden" name="auction_id" value="<%= auction.id %>"><input type="hidden" name="lot_id" value="<%= current_lot.id %>"><label>Bid team<select name="team_id"><% team_purses.forEach(p=>{ %><option value="<%= p.team_id %>"><%= p.team.name %> · remaining ₹<%= inr(p.remaining) %></option><% }) %></select></label><label>Bid amount (₹)<input type="number" name="amount" min="<%= current_lot.next_bid %>" value="<%= current_lot.next_bid %>" step="1" required></label><button class="btn" type="submit">Place bid</button></form><div class="actions"><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="sold"><input type="hidden" name="auction_id" value="<%= auction.id %>"><input type="hidden" name="lot_id" value="<%= current_lot.id %>"><button class="btn" type="submit">Mark sold</button></form><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="unsold"><input type="hidden" name="auction_id" value="<%= auction.id %>"><input type="hidden" name="lot_id" value="<%= current_lot.id %>"><button class="btn btn-outline" type="submit">Mark unsold</button></form></div><% } %></div><% } %>
<% if(upcoming_lots.length){ %><h3>Queued players</h3><ol class="auction-queue-list"><% upcoming_lots.forEach(lot=>{ %><li><span class="queue-number"><%= String(lot.position).padStart(2,'0') %></span><span class="queue-avatar"><%= initials(lot.player.name) %></span><div class="queue-player-copy"><strong><%= lot.player.name %></strong><small><%= lot.category_name %> · ₹<%= inr(lot.base_price) %></small></div><% if(['draft','ready'].includes(auction.status)){ %><div class="actions"><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="queue_move"><input type="hidden" name="auction_id" value="<%= auction.id %>"><input type="hidden" name="lot_id" value="<%= lot.id %>"><input type="hidden" name="direction" value="up"><button class="icon-button" type="submit" aria-label="Move <%= lot.player.name %> up">↑</button></form><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="queue_move"><input type="hidden" name="auction_id" value="<%= auction.id %>"><input type="hidden" name="lot_id" value="<%= lot.id %>"><input type="hidden" name="direction" value="down"><button class="icon-button" type="submit" aria-label="Move <%= lot.player.name %> down">↓</button></form></div><% } %></li><% }) %></ol><% } %>
<% } %></section>
</section><%- include('../partials/footer') %>
