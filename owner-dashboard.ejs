<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">SPL TEAM OWNER ROOM</p><h1>Your <em>auction desk</em></h1><p class="lead">Follow the live player queue, review your team purse, and place bids only for your assigned SPL teams.</p></section>
<section class="section owner-section">
  <% if(auctions.length){ %>
    <form class="filter-bar" method="get"><label for="owner-auction">Auction<select id="owner-auction" name="auction"><% auctions.forEach(item=>{ %><option value="<%= item.id %>"<%= selectedAuction?.id===item.id?' selected':'' %>><%= item.name %> · Season <%= item.season %> · <%= statusLabel(item.status) %></option><% }) %></select></label><button class="btn btn-gold" type="submit">Open auction</button></form>
  <% }else{ %><div class="empty-state">No auction is open for your assigned teams.</div><% } %>
  <% if(auction){ %>
    <div class="owner-auction-heading"><div><p class="eyebrow">SEASON <%= auction.season %> · <%= auction.status_display %></p><h2><%= auction.name %></h2></div><a class="text-link" href="/auction/">Public auction room →</a></div>
    <section class="owner-lot-layout" aria-label="Current auction lot">
      <div class="owner-lot-main"><p class="eyebrow"><%= current_lot?.category_name||'PLAYER AUCTION' %><%= current_lot?.is_marquee?' · MARQUEE':'' %></p><h3><%= current_lot?.player.name||(auction.status==='finalized'?'Auction complete':'No player is on the block') %></h3>
        <% if(current_lot){ %><p><%= current_lot.player.city||'SPL player' %> · Base price ₹<%= inr(current_lot.base_price) %></p><div class="owner-current-bid"><span>Current bid</span><strong>₹<%= inr(current_lot.current_bid||current_lot.base_price) %></strong><small>Next bid ₹<%= inr(current_lot.next_bid) %></small></div>
          <% if(auction.status==='running'&&team_purses.length){ %><form method="post" action="/owner/bid/" class="owner-bid-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= auctionNonce %>"><input type="hidden" name="auction_id" value="<%= auction.id %>"><input type="hidden" name="lot_id" value="<%= current_lot.id %>"><label>Your team<select name="team_id" required><% team_purses.forEach(purse=>{ %><option value="<%= purse.team.id %>"><%= purse.team.name %> · ₹<%= inr(purse.remaining) %> remaining</option><% }) %></select></label><label>Bid amount<input name="amount" type="number" min="<%= current_lot.next_bid %>" step="1" value="<%= current_lot.next_bid %>" required></label><button class="btn btn-accent" type="submit">Place bid <span aria-hidden="true">→</span></button></form><% }else if(auction.status!=='running'){ %><p class="form-note">Bidding is closed while the auction is <%= auction.status_display.toLowerCase() %>.</p><% } %>
        <% }else{ %><p class="body-copy">The player queue and results will appear as the auction progresses.</p><% } %>
      </div>
      <aside class="owner-purse-list"><p class="eyebrow">YOUR TEAM PURSES</p><% if(team_purses.length){ team_purses.forEach(purse=>{ %><div class="owner-purse"><div><strong><%= purse.team.name %></strong><span><%= purse.acquired_count %> players · ₹<%= inr(purse.spent) %> spent</span></div><b>₹<%= inr(purse.remaining) %></b></div><% })}else{ %><p class="form-note">No purse is configured for your team in this auction.</p><% } %></aside>
    </section>
    <div class="owner-auction-lists"><section><div class="section-head"><div><p class="eyebrow">UP NEXT</p><h2>Player queue</h2></div><span><%= queued_count||0 %> queued</span></div><% if(upcoming_lots?.length){ %><ol class="auction-queue-list"><% upcoming_lots.forEach(lot=>{ %><li><span class="queue-number"><%= String(lot.position).padStart(2,'0') %></span><span class="queue-avatar"><%= initials(lot.player.name) %></span><div class="queue-player-copy"><strong><%= lot.player.name %></strong><small><%= lot.category_name %> · ₹<%= inr(lot.base_price) %></small></div></li><% }) %></ol><% }else{ %><p class="editorial-empty">No players are waiting in the queue.</p><% } %></section>
      <section><div class="section-head"><div><p class="eyebrow">RECENT RESULTS</p><h2>Sold and unsold</h2></div><span><%= sold_count||0 %> sold</span></div><% if(previous_lots?.length){ %><div class="owner-result-list"><% previous_lots.forEach(lot=>{ %><div><span class="owner-result-status <%= lot.status==='sold'?'is-sold':'is-unsold' %>"><%= lot.status %></span><strong><%= lot.player.name %></strong><% if(lot.status==='sold'){ %><small><%= lot.highest_team?.name||'Team' %> · ₹<%= inr(lot.sold_price) %></small><% } %></div><% }) %></div><% }else{ %><p class="editorial-empty">No player results have been saved yet.</p><% } %></section></div>
  <% } %>
</section>
<%- include('../partials/footer') %>
