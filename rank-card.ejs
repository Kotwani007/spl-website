<section class="leaderboard-card <%= kind==='mvp'?'featured':'' %>"><div class="leaderboard-card-head"><div><p class="eyebrow"><%= eyebrow %></p><h2><%= title %></h2></div></div><% if(kind==='mvp'){ %><p class="leaderboard-explainer">Runs + (4s × 7) + (6s × 9) + (wickets × 25)</p><% }else if(kind==='fielding'){ %><p class="leaderboard-explainer">1 point per catch or run-out effected.</p><% } %><ol class="rank-list"><% if(rows.length){rows.forEach((x,index)=>{ %><li class="rank-row" <%= index>=10?'hidden':'' %>><span class="rank-number"><%= String(index+1).padStart(2,'0') %></span><span class="rank-player"><b><%= x.name %></b><small><% if(kind==='mvp'){ %><%= x.team %> · <%= x.runs %> runs · <%= x.wickets %> wkts<% }else if(kind==='batting'){ %><%= x.team %> · <%= x.matches_played %> matches · SR <%= x.strike_rate %><% }else if(kind==='bowling'){ %><%= x.team %> · Econ <%= x.economy %><% }else if(kind==='dots'){ %><%= x.team %> · <%= x.wickets %> wickets<% }else if(kind==='appearances'){ %><%= x.teams %><% }else{ %><%= x.team %> · <%= x.catches %> catches · <%= x.run_outs %> run-outs<% } %></small></span><strong><% if(kind==='mvp'){ %><%= x.points %><% }else if(kind==='batting'){ %><%= x.runs %><% }else if(kind==='bowling'){ %><%= x.wickets %><% }else if(kind==='dots'){ %><%= x.dot_balls %><% }else if(kind==='appearances'){ %><%= x.matches_played %><% }else{ %><%= x.dismissals %><% } %> <small><%= unit %></small></strong></li><% })}else{ %><li class="empty-state"><%= kind==='mvp'?'MVP rankings will appear when player scorecards are available.':kind==='batting'?'No batting data available.':kind==='bowling'||kind==='dots'?'No bowling data available.':kind==='appearances'?'No appearance data available.':'Fielding rankings require recorded ball-by-ball fielder data. Imported historical scorecards do not contain individual catch/run-out attribution.' %></li><% } %></ol><% if(rows.length>10){ %><button class="show-more" type="button">Show more <span>＋</span></button><% } %></section>
