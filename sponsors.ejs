<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">OUR PARTNERS</p><h1>Backing the game.</h1><p class="lead">We thank the businesses and supporters who help make SPL possible.</p></section><section class="section"><h2>Title sponsor</h2><div class="sponsor-wall"><% const titleSponsors=sponsors.filter(s=>s.category==='title'); if(titleSponsors.length){titleSponsors.forEach(s=>{ %><article class="sponsor-card"><% if(s.logo_url){ %><img src="<%= s.logo_url %>" alt="<%= s.name %>"><% }else{ %><div class="sponsor-placeholder"><%= s.name.slice(0,1) %></div><% } %><h3><%= s.name %></h3><% if(s.website){ %><a href="<%= s.website %>" target="_blank" rel="noopener">Visit website ↗</a><% } %></article><% })}else{ %><div class="empty-state">Title sponsor announcements coming soon.</div><% } %></div><h2 class="section-subhead">Associate partners</h2><div class="sponsor-wall"><% const associates=sponsors.filter(s=>s.category==='associate'); if(associates.length){associates.forEach(s=>{ %><article class="sponsor-card"><% if(s.logo_url){ %><img src="<%= s.logo_url %>" alt="<%= s.name %>"><% }else{ %><div class="sponsor-placeholder"><%= s.name.slice(0,1) %></div><% } %><h3><%= s.name %></h3><% if(s.website){ %><a href="<%= s.website %>" target="_blank" rel="noopener">Visit website ↗</a><% } %></article><% })}else{ %><div class="empty-state">Associate partners will be announced here.</div><% } %></div><p class="body-copy">Interested in supporting the league? <a href="/contact/">Contact the SPL team.</a></p></section>
<%- include('../partials/footer') %>
