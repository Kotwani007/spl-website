<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">THE PLAYERS</p><h1>Meet the players</h1><p class="lead">Discover the people behind the performances.</p></section>
<section class="section"><div class="section-head"><div><p class="eyebrow">THE SQUADS</p><h2>Player directory</h2></div><a class="text-link" href="/players/compare/">Compare players →</a></div><form class="filter-bar" method="get"><label>Find player <input name="q" value="<%= search %>" placeholder="Player name"></label><button class="btn btn-gold">Search</button></form><div class="card-grid"><% if(players.length){players.forEach(player=>{ %><article class="player-card"><div class="player-avatar"><% if(player.photo_url){ %><img src="<%= player.photo_url %>" alt="<%= player.name %>" loading="lazy" decoding="async"><% }else{ %><%= player.name.slice(0,1).toUpperCase() %><% } %></div><h3><a href="/players/<%= player.id %>/"><%= player.name %></a></h3><p><%= player.teams.length?player.teams.map(t=>t.name).join(', '):'Team not assigned' %></p><p><%= player.matches_played_count %> matches played</p></article><% })}else{ %><div class="empty-state">Player profiles will appear here.</div><% } %></div></section>
<%- include('../partials/footer') %>
