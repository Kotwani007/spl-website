<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">SEASON <%= team.tournament.season %> · TEAM SQUAD</p><h1><%= team.name %></h1><p class="lead">Players who represented <%= team.name %> in Season <%= team.tournament.season %>.</p></section>
<section class="section"><div class="section-head"><div><p class="eyebrow">THE SQUAD</p><h2><%= players.length %> players</h2></div><a class="text-link" href="/teams/?season=<%= team.tournament.season %>">← Back to teams</a></div><div class="card-grid"><% if(players.length){players.forEach(player=>{ %><a class="player-card" href="/players/<%= player.id %>/"><div class="player-avatar"><% if(player.photo_url){ %><img src="<%= player.photo_url %>" alt="<%= player.name %>"><% }else{ %><%= player.name.slice(0,1) %><% } %></div><h3><%= player.name %></h3><p><%= player.city||'SPL Player' %></p></a><% })}else{ %><div class="empty-state">No player appearances are recorded for this team yet.</div><% } %></div></section>
<%- include('../partials/footer') %>
