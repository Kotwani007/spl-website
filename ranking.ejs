<section class="leaderboard-card <%= kind==='mvp'?'featured':'' %>"><div class="leaderboard-card-head"><div><p class="eyebrow"><%= eyebrow %></p><h2><%= title %></h2></div></div><% if(kind==='mvp'){ %><p class="leaderboard-explainer">Runs + (4s × 7) + (6s × 9) + (wickets × 25)</p><% } else if(kind==='fielding'){ %><p class="leaderboard-explainer">Recorded catch and run-out attributions. One point per contribution.</p><% } %><ol class="rank-list"><% if(rows.length){rows.forEach((row,index)=>{ %><li class="rank-row"<%= index>=10?' hidden':'' %>><span class="rank-number"><%= String(index+1).padStart(2,'0') %></span><span class="rank-player"><b><%= row.name %></b><small><%= kind==='appearances'?(row.teams||row.team):row.team %><% if(kind==='batting'){ %> · <%= row.appearances %> matches · SR <%= row.balls_faced ? (100*row.runs/row.balls_faced).toFixed(2) : '0.00' %><% }else if(kind==='bowling'){ %> · Economy <%= row.bowling_runs || 0 %><% }else if(kind==='mvp'){ %> · <%= row.runs %> runs · <%= row.wickets %> wickets<% }else if(kind==='fielding'){ %> · recorded dismissals<% } %></small></span><strong><%= kind==='batting'?row.runs:kind==='bowling'?row.wickets:kind==='mvp'?row.mvp:kind==='dots'?row.dot_balls:kind==='appearances'?row.appearances:row.value %><small><%= unit %></small></strong></li><% })}else{ %><li class="empty-state"><p>These rankings will appear when supported figures are recorded.</p></li><% } %></ol><% if(rows.length>10){ %><button class="show-more" type="button">Show next 10</button><% } %></section>
