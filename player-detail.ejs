<%- include('../partials/header') %>
<% const totals=analytics.totals; const latestTeam=player.teams[0]||null; const maxRuns=Math.max(1,...analytics.recent.map(row=>Number(row.runs||0))); const maxWickets=Math.max(1,...analytics.recent.map(row=>Number(row.wickets||0))); %>
<section class="player-profile-hero">
  <div class="player-profile-photo"><% if(player.photo_url){ %><img src="<%= player.photo_url %>" alt="<%= player.name %>" fetchpriority="high"><% }else{ %><span aria-hidden="true"><%= initials(player.name) %></span><small>PLAYER PHOTO NOT IN SOURCE FILES</small><% } %></div>
  <div class="player-profile-copy"><p class="eyebrow">SPL PLAYER PROFILE <%= latestTeam?`· SEASON ${latestTeam.tournament.season}`:'' %></p><h1><%= player.name %></h1><p class="player-profile-meta"><%= player.city||'City not recorded' %><%= latestTeam?` · ${latestTeam.name}`:'' %></p><p class="player-profile-availability">Career numbers use the supplied player-match records. Fields absent from the original data are marked unavailable.</p><a class="btn btn-quiet" href="/players/compare/?a=<%= player.id %>">Compare this player</a></div>
</section>
<section class="section player-profile-section">
  <div class="player-career-strip" aria-label="Recorded career totals"><div><b><%= totals.runs %></b><span>RUNS</span></div><div><b><%= totals.wickets %></b><span>WICKETS</span></div><div><b><%= totals.matches %></b><span>MATCHES</span></div><div><b><%= totals.strike_rate==null?'—':totals.strike_rate %></b><span>STRIKE RATE</span></div></div>
  <form method="get" class="filter-bar player-season-filter"><label for="profile-season">Performance season<select id="profile-season" name="season"><option value="">All recorded seasons</option><% analytics.seasons.forEach(season=>{ %><option value="<%= season %>"<%= Number(selectedSeason)===season?' selected':'' %>>Season <%= season %></option><% }) %></select></label><button class="btn btn-gold" type="submit">Apply</button><a class="text-link" href="/players/<%= player.id %>/">Clear filter</a></form>
  <div class="player-tabs" role="tablist" aria-label="Player profile sections">
    <button id="player-tab-overview" role="tab" aria-selected="true" aria-controls="player-panel-overview" tabindex="0">Overview</button>
    <button id="player-tab-batting" role="tab" aria-selected="false" aria-controls="player-panel-batting" tabindex="-1">Batting</button>
    <button id="player-tab-bowling" role="tab" aria-selected="false" aria-controls="player-panel-bowling" tabindex="-1">Bowling</button>
    <button id="player-tab-record" role="tab" aria-selected="false" aria-controls="player-panel-record" tabindex="-1">History</button>
  </div>
  <section id="player-panel-overview" role="tabpanel" aria-labelledby="player-tab-overview" class="player-tab-panel">
    <div class="player-overview-grid"><section><div class="section-head"><div><p class="eyebrow">RECENT FORM</p><h2>Latest recorded performances</h2></div><span><%= analytics.recent.length %> match rows</span></div>
      <% if(analytics.recent.length){ %><div class="player-form-chart" aria-label="Recent runs and wickets"><% analytics.recent.forEach(row=>{ const runsWidth=Math.max(Number(row.runs||0)?4:0,Math.round(Number(row.runs||0)*100/maxRuns)); const wicketsWidth=Math.max(Number(row.wickets||0)?4:0,Math.round(Number(row.wickets||0)*100/maxWickets)); %><a class="player-form-row" href="/matches/<%= row.match_id %>/"><span class="player-form-date"><%= date(row.match_date) %></span><strong><%= row.team_a_name %> vs <%= row.team_b_name %></strong><span class="player-form-stat"><i class="runs-bar" style="width:<%= runsWidth %>%"></i><b><%= row.runs %> runs</b></span><span class="player-form-stat"><i class="wickets-bar" style="width:<%= wicketsWidth %>%"></i><b><%= row.wickets %> wkts</b></span></a><% }) %></div><% }else{ %><p class="editorial-empty">No match statistics are recorded for this selection.</p><% } %>
    </section><aside class="player-profile-facts"><p class="eyebrow">PLAYER DETAILS</p><dl><div><dt>City</dt><dd><%= player.city||'Not recorded' %></dd></div><div><dt>Current team</dt><dd><%= latestTeam?.name||'Not recorded' %></dd></div><div><dt>Role</dt><dd>Not recorded</dd></div><div><dt>Batting style</dt><dd>Not recorded</dd></div><div><dt>Bowling style</dt><dd>Not recorded</dd></div></dl><p>Jersey number, role, and playing style were not available in the supplied player records.</p></aside></div>
  </section>
  <section id="player-panel-batting" role="tabpanel" aria-labelledby="player-tab-batting" class="player-tab-panel" hidden>
    <div class="section-head"><div><p class="eyebrow">BATTING RECORD</p><h2>Career batting</h2></div><span>From supplied scorecard statistics</span></div><div class="player-metric-table"><div><span>Recorded innings</span><b><%= totals.batting_innings %></b></div><div><span>Runs</span><b><%= totals.runs %></b></div><div><span>Not outs</span><b><%= totals.not_outs %></b></div><div><span>Batting average</span><b><%= totals.batting_average==null?'—':totals.batting_average %></b></div><div><span>Highest score</span><b><%= analytics.rows.length?Math.max(0,...analytics.rows.map(row=>Number(row.runs||0))):'—' %></b></div><div><span>Balls faced</span><b><%= totals.balls_faced %></b></div><div><span>Strike rate</span><b><%= totals.strike_rate==null?'—':totals.strike_rate %></b></div><div><span>Fours · sixes</span><b><%= totals.fours %> · <%= totals.sixes %></b></div></div><p class="table-note">Average is runs divided by recorded dismissals. Strike rate is runs per 100 recorded balls. The source has no reliable duck or milestone fields.</p>
  </section>
  <section id="player-panel-bowling" role="tabpanel" aria-labelledby="player-tab-bowling" class="player-tab-panel" hidden>
    <div class="section-head"><div><p class="eyebrow">BOWLING RECORD</p><h2>Career bowling</h2></div><span>Overs are stored as legal balls</span></div><div class="player-metric-table"><div><span>Bowling innings</span><b><%= totals.bowling_innings %></b></div><div><span>Wickets</span><b><%= totals.wickets %></b></div><div><span>Legal balls</span><b><%= totals.bowling_balls %> · <%= totals.bowling_overs %> ov</b></div><div><span>Runs conceded</span><b><%= totals.bowling_runs %></b></div><div><span>Best recorded figures</span><b><%= totals.best_bowling||'—' %></b></div><div><span>Bowling average</span><b><%= totals.bowling_average==null?'—':totals.bowling_average %></b></div><div><span>Economy</span><b><%= totals.economy==null?'—':totals.economy %></b></div><div><span>Bowling strike rate</span><b><%= totals.bowling_strike_rate==null?'—':totals.bowling_strike_rate %></b></div><div><span>Dot balls · maidens</span><b><%= totals.dot_balls %> · <%= totals.maidens %></b></div></div><p class="table-note">Bowling average is runs conceded per wicket; economy is runs conceded per six legal balls. Historical figures use the overs recorded in the supplied statistics.</p>
  </section>
  <section id="player-panel-record" role="tabpanel" aria-labelledby="player-tab-record" class="player-tab-panel" hidden>
    <div class="section-head"><div><p class="eyebrow">SEASON RECORD</p><h2>Match-by-match record</h2></div><span><%= analytics.rows.length %> rows</span></div><div class="table-wrap"><table class="score-table"><thead><tr><th>Season</th><th>Match</th><th>Team</th><th>Runs</th><th>Balls</th><th>Wickets</th><th>Bowling runs</th></tr></thead><tbody><% if(analytics.rows.length){analytics.rows.forEach(row=>{ %><tr><td>Season <%= row.tournament_season %></td><td><a href="/matches/<%= row.match_id %>/"><%= date(row.match_date) %> · <%= row.team_a_name %> vs <%= row.team_b_name %></a></td><td><%= row.performance_team_name %></td><td><%= row.runs %></td><td><%= row.balls_faced %></td><td><%= row.wickets %></td><td><%= row.bowling_runs %></td></tr><% })}else{ %><tr><td colspan="7">No match statistics are recorded.</td></tr><% } %></tbody></table></div>
    <div class="player-history-grid"><section><p class="eyebrow">FIELDING</p><h3>Fielding record</h3><% if(analytics.fielding.available){ %><p><strong><%= analytics.fielding.catches %></strong> catches · <strong><%= analytics.fielding.run_outs %></strong> run-outs · <strong><%= analytics.fielding.stumpings %></strong> stumpings</p><% }else{ %><p class="editorial-empty">Unavailable in the source records because no delivery-level fielding history was supplied.</p><% } %></section><section><p class="eyebrow">AUCTION HISTORY</p><h3>Player purchases</h3><% if(analytics.auctionHistory.length){ analytics.auctionHistory.forEach(sale=>{ %><p><strong>Season <%= sale.season %></strong> · <%= sale.auction_name %> · <%= sale.team_name %> · ₹<%= inr(sale.sold_price) %></p><% })}else{ %><p class="editorial-empty">No saved auction history for this player.</p><% } %></section></div>
  </section>
</section>
<%- include('../partials/footer') %>
