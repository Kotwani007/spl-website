<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">PLAYER ANALYTICS</p><h1>Compare <em>players</em></h1><p class="lead">Compare only the match and auction figures present in SPL’s saved records. Missing fields remain unfilled.</p></section>
<section class="section player-compare-section"><form method="get" class="player-compare-form"><label>Player one<select name="a" required><option value="">Choose player</option><% players.forEach(player=>{ %><option value="<%= player.id %>"<%= Number(selectedA)===player.id?' selected':'' %>><%= player.name %></option><% }) %></select></label><label>Player two<select name="b" required><option value="">Choose player</option><% players.forEach(player=>{ %><option value="<%= player.id %>"<%= Number(selectedB)===player.id?' selected':'' %>><%= player.name %></option><% }) %></select></label><label>Season<select name="season"><option value="">All recorded seasons</option><% seasons.forEach(item=>{ %><option value="<%= item.season %>"<%= Number(selectedSeason)===item.season?' selected':'' %>>Season <%= item.season %></option><% }) %></select></label><button class="btn btn-gold" type="submit">Compare players</button></form>
  <% if(comparison){ const left=comparison.a; const right=comparison.b; const rows=[['Matches',left.totals.matches,right.totals.matches],['Runs',left.totals.runs,right.totals.runs],['Batting average',left.totals.batting_average,right.totals.batting_average],['Strike rate',left.totals.strike_rate,right.totals.strike_rate],['Highest score',left.rows.length?Math.max(...left.rows.map(r=>Number(r.runs||0))):null,right.rows.length?Math.max(...right.rows.map(r=>Number(r.runs||0))):null],['Fours',left.totals.fours,right.totals.fours],['Sixes',left.totals.sixes,right.totals.sixes],['Wickets',left.totals.wickets,right.totals.wickets],['Bowling average',left.totals.bowling_average,right.totals.bowling_average],['Economy',left.totals.economy,right.totals.economy],['Legal balls bowled',left.totals.bowling_balls,right.totals.bowling_balls],['Dot balls',left.totals.dot_balls,right.totals.dot_balls]]; %>
    <div class="player-compare-head"><article><a href="/players/<%= left.player.id %>/"><span class="compare-player-mark"><%= initials(left.player.name) %></span><div><p class="eyebrow">PLAYER ONE</p><h2><%= left.player.name %></h2><small><%= left.player.teams[0]?.name||left.player.city||'SPL player' %></small></div></a></article><span aria-hidden="true">VS</span><article><a href="/players/<%= right.player.id %>/"><span class="compare-player-mark"><%= initials(right.player.name) %></span><div><p class="eyebrow">PLAYER TWO</p><h2><%= right.player.name %></h2><small><%= right.player.teams[0]?.name||right.player.city||'SPL player' %></small></div></a></article></div>
    <div class="table-wrap"><table class="score-table player-compare-table"><thead><tr><th><%= left.player.name %></th><th>Statistic</th><th><%= right.player.name %></th></tr></thead><tbody><% rows.forEach(([label,a,b])=>{ %><tr><td><%= a==null?'—':a %></td><th scope="row"><%= label %></th><td><%= b==null?'—':b %></td></tr><% }) %></tbody></table></div><p class="table-note">Bowling and batting rates are calculated from supplied scorecard totals. Fielding, roles, and auction valuation history are excluded when source records do not support them.</p>
  <% }else{ %><div class="empty-state player-compare-empty"><p class="eyebrow">SIDE BY SIDE</p><h2>Select two players</h2><p>Choose any two saved profiles to view the statistics that are available for their record.</p></div><% } %>
</section>
<%- include('../partials/footer') %>
