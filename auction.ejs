<%- include('../partials/header') %>
<section class="page-hero auction-page-hero"><div class="container auction-page-heading"><div><p class="eyebrow">SINDHI PREMIER LEAGUE · LIVE PLAYER AUCTION</p><h1>The auction room.</h1><p class="lead">Every signing starts here. Follow the player on the block, team purses and the full queue.</p></div><div class="auction-room-actions"><button class="btn btn-outline" type="button" data-projector>Projector mode</button><span class="auction-status-pill <%= auction?.status==='running'?'is-live':auction?.status==='paused'?'is-paused':'' %>"><% if(auction?.status==='running'){ %><i></i><% } %><%= auction?.status_display || 'No auction announced' %></span><% if(user.is_staff){ %><a class="btn btn-outline" href="/organiser/auction/">Auction controls</a><% } %></div></div></section>
<section class="container section auction-page" id="auction-page" data-refresh-url="/auction/?fragment=live" data-refresh-active="<%= refresh_active ? 'true' : 'false' %>"><% if(auction?.id){ %><div class="leaderboard-actions"><a class="text-link" href="/auction/export.csv?auction=<%= auction.id %>">Download auction results CSV ↓</a></div><% } %><div id="auction-live-region" aria-live="polite" aria-atomic="false"><%- include('../partials/auction-live') %></div></section>
<%- include('../partials/footer') %>
