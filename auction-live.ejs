<div id="auction-live-fragment" data-auction-status="<%= auction?.status || 'none' %>"><% if(auction){ %>
<div class="auction-broadcast-bar"><div><span class="auction-season-label">SINDHI PREMIER LEAGUE · SEASON <%= auction.season %></span><strong><%= auction.name %></strong></div><span class="auction-refresh-note"><i class="live-dot"></i><%= auction.status_display %></span></div>
<div class="auction-scoreboard"><div><span>Players auctioned</span><strong><%= auctioned_count %><small> / <%= total_lots %></small></strong></div><div><span>Players sold</span><strong><%= sold_count %></strong></div><div><span>Players remaining</span><strong><%= queued_count %></strong></div><div><span>Highest bid</span><strong><%= highest_bid ? `₹${inr(highest_bid)}` : '—' %></strong></div></div>
<div class="auction-showcase-grid"><section class="auction-player-card"><div class="auction-photo-wrap"><% if(current_lot?.player.photo_url){ %><img class="auction-player-photo" src="<%= current_lot.player.photo_url %>" alt="<%= current_lot.player.name %>" loading="lazy"><% } else { %><div class="auction-player-fallback"><span><%= current_lot ? initials(current_lot.player.name) : 'SPL' %></span><small><%= current_lot ? 'SPL · PLAYER' : 'THE NEXT SIGNING' %></small></div><% } %><% if(current_lot){ %><span class="auction-lot-number">LOT <%= String(current_lot.position).padStart(2,'0') %></span><% } %></div>
<div class="auction-player-copy"><p class="eyebrow"><%= current_lot ? current_lot.category_name : 'THE PLAYER ON THE BLOCK' %><%= current_lot?.is_marquee ? ' · MARQUEE' : '' %></p><h2><%= current_lot?.player.name || (auction.status==='finalized'?'Auction complete':'The next bid is waiting.') %></h2><p><%= current_lot?.player.city || (current_lot ? 'SPL player' : 'Live bid information will appear here when a player is on the block.') %></p><% if(current_lot){ %><dl class="auction-player-facts"><div><dt>Base price</dt><dd>₹<%= inr(current_lot.base_price) %></dd></div><div><dt>Current bid</dt><dd>₹<%= inr(current_lot.current_bid) %></dd></div><div><dt>Next bid</dt><dd>₹<%= inr(current_lot.next_bid) %></dd></div></dl><% if(current_lot.highest_team){ %><div class="auction-leading-team"><span class="auction-team-mark"><%= initials(current_lot.highest_team.short_name||current_lot.highest_team.name) %></span><div><small>HIGHEST BIDDER</small><b><%= current_lot.highest_team.name %></b></div></div><% } %><% } else { %><p><%= auction.status==='ready'?'The auction is staged. Follow along as the organiser brings the first player to the block.':'Live bid information will appear here when a player is on the block.' %></p><% } %></div></section>
<section class="auction-panel auction-current-panel"><p class="eyebrow">THE LIVE ROOM</p><h2><%= current_lot ? 'Current bid' : 'Auction status' %></h2><% if(current_lot){ %><strong class="auction-current-bid">₹<%= inr(current_lot.current_bid || current_lot.base_price) %></strong><p><%= current_lot.highest_team ? `Leading · ${current_lot.highest_team.name}` : `Opening price · ₹${inr(current_lot.base_price)}` %></p><div class="auction-next-bid"><span>Next bid</span><b>₹<%= inr(current_lot.next_bid) %></b><small>Increment ₹<%= inr(auction.bid_increment) %></small></div><span class="auction-on-block">PLAYER ON THE BLOCK</span><% } else { %><strong class="auction-current-bid is-unset">—</strong><h2><%= auction.status==='finalized'?'Auction complete':'The next bid is waiting.' %></h2><p>Live bid information will appear here when a player is on the block.</p><% } %><div class="auction-facts"><div><span>Sold</span><b><%= sold_count %></b></div><div><span>Unsold</span><b><%= unsold_count %></b></div><div><span>Queued</span><b><%= queued_count %></b></div></div></section></div>
<div class="auction-broadcast-columns"><section class="auction-panel auction-purses"><div class="auction-section-heading"><div><p class="eyebrow">THE FRANCHISES</p><h2>Team purses</h2></div><span><%= team_purses.length %> teams</span></div><% if(team_purses.length){ %><div class="auction-team-grid"><% team_purses.forEach(purse=>{ %><article class="auction-team-card" style="--team-colour:<%= teamColour(purse.team.primary_colour) %>"><div class="auction-team-card-head"><span class="auction-team-mark"><%= initials(purse.team.short_name||purse.team.name) %></span><strong><%= purse.team.name %></strong></div><div class="auction-purse-numbers"><span>Remaining<strong>₹<%= inr(purse.remaining) %></strong></span><span>Spent<strong>₹<%= inr(purse.spent) %></strong></span></div><div class="auction-purse-meter" role="img" aria-label="₹<%= inr(purse.spent) %> of ₹<%= inr(purse.budget) %> spent"><i style="width:<%= purse.percent_spent %>%"></i></div><small><%= purse.acquired_count %> players acquired · ₹<%= inr(purse.budget) %> purse</small></article><% }) %></div><% }else{ %><p class="auction-muted">Team purses will appear when the organiser configures this auction.</p><% } %></section>
<section class="auction-panel auction-history-panel"><div class="auction-section-heading"><div><p class="eyebrow">THE BIDDING</p><h2>Recent bids</h2></div><span>Most recent</span></div><% if(recent_bids.length){ %><ol class="auction-bid-history"><% recent_bids.forEach(bid=>{ %><li><span class="bid-history-mark"><%= initials(bid.team.short_name||bid.team.name) %></span><div><strong><%= bid.team.name %></strong><small><%= bid.lot.player.name %></small></div><b>₹<%= inr(bid.amount) %></b></li><% }) %></ol><% }else{ %><p class="auction-muted">The first bid will set the tone. Bid history will build here.</p><% } %></section>
<section class="auction-panel auction-summary-panel"><div class="auction-section-heading"><div><p class="eyebrow">THE NUMBERS</p><h2>Auction stats</h2></div></div><dl class="auction-stat-list"><div><dt>Players auctioned</dt><dd><%= auctioned_count %> <small>/ <%= total_lots %></small></dd></div><div><dt>Highest bid</dt><dd><%= highest_bid ? `₹${inr(highest_bid)}` : '—' %></dd></div><div><dt>Most expensive</dt><dd><%= top_sale ? top_sale.player.name : '—' %><% if(top_sale){ %><small> ₹<%= inr(top_sale.sold_price) %></small><% } %></dd></div></dl></section></div>
<div class="auction-bottom-grid"><section class="auction-panel auction-queue-panel"><div class="auction-section-heading"><div><p class="eyebrow">UP NEXT</p><h2>Player queue</h2></div><span><%= queued_count %> remaining</span></div><% if(upcoming_lots.length){ %><ol class="auction-queue-list"><% upcoming_lots.forEach(lot=>{ %><li><span class="queue-number"><%= String(lot.position).padStart(2,'0') %></span><span class="queue-avatar"><%= initials(lot.player.name) %></span><div class="queue-player-copy"><strong><%= lot.player.name %><%= lot.is_marquee?' ✦ MARQUEE':'' %></strong><small><%= lot.category_name %> · Base ₹<%= inr(lot.base_price) %></small></div><span class="queue-state">UPCOMING</span></li><% }) %></ol><% }else{ %><p class="auction-muted">No players are waiting in the queue.</p><% } %></section>
<section class="auction-panel auction-results-panel"><div class="auction-section-heading"><div><p class="eyebrow">RECENTLY CALLED</p><h2>Results</h2></div><span><%= sold_count %> sold · <%= unsold_count %> unsold</span></div><% if(previous_lots.length){ %><ol class="auction-result-list"><% previous_lots.forEach(lot=>{ %><li class="<%= lot.status==='sold'?'result-sold':'result-unsold' %>"><div><strong><%= lot.player.name %></strong><small><%= lot.category_name %><%= lot.is_marquee?' · Marquee':'' %></small></div><span class="result-label"><%= lot.status.toUpperCase() %></span><b><%= lot.status==='sold'?`₹${inr(lot.sold_price)}`:'—' %></b></li><% }) %></ol><% }else{ %><p class="auction-muted">Sold and unsold results will appear here as the auction progresses.</p><% } %></section>
<section class="auction-panel auction-category-panel"><div class="auction-section-heading"><div><p class="eyebrow">CATEGORY SALES</p><h2>By player category</h2></div></div><% if(category_sales.length){ %><ul class="auction-category-sales"><% category_sales.forEach(row=>{ %><li><span><%= row.category_name %></span><b><%= row.players_sold %> sold</b><strong>₹<%= inr(row.total_spend) %></strong></li><% }) %></ul><% }else{ %><p class="auction-muted">Category totals will appear after the first sale.</p><% } %></section></div>
<% } else { %><div class="auction-no-announcement"><div class="auction-empty-mark">SPL</div><div><p class="eyebrow">SPL AUCTION ROOM</p><h2>No auction announced</h2><p>There is no active auction to follow yet. Once organisers publish a player queue, the live presentation, team purses and results will appear here.</p><% if(user?.is_staff){ %><a class="btn" href="/organiser/auction/">Configure an auction</a><% } %></div></div><% } %></div>
