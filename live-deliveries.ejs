<div class="data-panel live-deliveries"><div class="section-head"><div><p class="eyebrow">BALL-BY-BALL</p><h2>Latest deliveries</h2></div></div><% innings_list.forEach(inn=>{ %><h3>Innings <%= inn.innings_number %> · <%= inn.batting_team.name %></h3><% if(inn.deliveries.length){inn.deliveries.slice(0,18).forEach(d=>{ %><p><b><%= d.over_number %>.<%= d.ball_number %></b><span><%= d.batter.name %> · <%= d.bowler.name %></span><strong><%= Number(d.batter_runs)+Number(d.extra_runs) %><%= d.dismissal_type?' W':'' %></strong></p><% })}else{ %><p>No deliveries recorded yet.</p><% } %><% }) %></div>
