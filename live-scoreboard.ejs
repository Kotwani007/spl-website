<div class="live-scoreboard"><div class="live-pill"><i></i> <%= match.status==='live'?'LIVE':statusLabel(match.status).toUpperCase() %></div><% if(innings_list.length){innings_list.forEach(inn=>{ %><div class="innings-score"><span>INNINGS <%= inn.innings_number %> · <%= inn.batting_team.name %></span><b><%= inn.total_runs %>/<%= inn.wickets %></b><small><%= overs(inn.legal_balls) %> overs</small></div><% })}else{ %><div class="innings-score"><span>WAITING FOR FIRST DELIVERY</span><b>0/0</b><small>0.0 overs</small></div><% } %></div>
<% if(current_innings){ %><div class="data-panel live-innings-panel"><p class="eyebrow"><%= match.status==='live'?'CURRENT INNINGS':'FINAL INNINGS' %></p><h2><%= current_innings.batting_team.name %> <%= match.status==='live'?'batting':'innings' %></h2><p><span>Score</span><b><%= current_innings.total_runs %> / <%= current_innings.wickets %></b></p><p><span>Overs</span><b><%= overs(current_innings.legal_balls) %></b></p><p><span>Bowling team</span><b><%= current_innings.bowling_team.name %></b></p></div><% } %>
