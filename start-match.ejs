<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">ORGANISER CONTROL ROOM</p><h1>Start a <em>match</em></h1><p class="lead">Choose the tournament and the two teams. Team A will bat first.</p></section><section class="section"><form method="post" class="start-match-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label>Tournament<select name="tournament" id="tournament" required><option value="">Select season</option><% tournaments.forEach(t=>{ %><option value="<%= t.id %>">Season <%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Team A · batting first<select name="team_a" id="team-a" required><option value="">Select batting team</option><% teams.forEach(team=>{ %><option value="<%= team.id %>" data-tournament="<%= team.tournament_id %>"><%= team.name %> · Season <%= team.tournament.season %></option><% }) %></select></label><label>Team B · bowling first<select name="team_b" id="team-b" required><option value="">Select bowling team</option><% teams.forEach(team=>{ %><option value="<%= team.id %>" data-tournament="<%= team.tournament_id %>"><%= team.name %> · Season <%= team.tournament.season %></option><% }) %></select></label><p class="form-note">Starting a match creates a live fixture and its first innings. Ball-by-ball scoring can then be entered from the live scoring screen.</p><button class="btn btn-gold" type="submit">Start live match →</button></form></section>
<script>const season=document.querySelector('#tournament');function filterTeams(){[document.querySelector('#team-a'),document.querySelector('#team-b')].forEach(select=>{[...select.options].forEach((o,i)=>{if(!i)return;o.hidden=!!season.value&&o.dataset.tournament!==season.value;if(o.hidden&&o.selected)select.value='';});});}season.addEventListener('change',filterTeams);filterTeams();</script><%- include('../partials/footer') %>
