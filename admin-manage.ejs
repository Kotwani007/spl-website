<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">ORGANISED LEAGUE RECORDS</p><h1>League <em>admin</em></h1><p class="lead">Update seasons, squads, fixtures, partners and enquiries. Live scoring and auction controls stay in their dedicated desks.</p></section>
<section class="section admin-workspace">
  <nav class="admin-section-nav" aria-label="League record types"><% [['seasons','Seasons'],['teams','Teams'],['players','Players'],['matches','Matches'],['sponsors','Sponsors'],['enquiries','Enquiries']].forEach(([key,label])=>{ %><a class="<%= section===key?'is-current':'' %>" href="/organiser/manage/?section=<%= key %>"><%= label %></a><% }) %><% if(user?.roles?.includes('super_admin')){ %><a class="<%= section==='access'?'is-current':'' %>" href="/organiser/manage/?section=access">Access &amp; roles</a><% } %></nav>
  <div class="section-head admin-section-head"><div><p class="eyebrow">RECORDS · <%= section.toUpperCase() %></p><h2><%= section==='seasons'?'Tournament seasons':section==='teams'?'League teams':section==='players'?'Player profiles':section==='matches'?'Fixtures and results':section==='sponsors'?'League sponsors':section==='access'?'Accounts and permissions':'Contact enquiries' %></h2></div><span><%= total %> records</span></div>
  <% if(['teams','players','matches','sponsors','enquiries','access'].includes(section)){ %><form class="filter-bar admin-search" method="get"><input type="hidden" name="section" value="<%= section %>"><label>Search records<input type="search" name="q" value="<%= search %>" placeholder="Name, team, stage, or email"></label><button class="btn btn-gold" type="submit">Search</button><% if(search){ %><a class="btn btn-outline-dark" href="/organiser/manage/?section=<%= section %>">Clear</a><% } %></form><% } %>

  <% if(section==='seasons'){ %>
    <details class="admin-create-box" open><summary>Add a season</summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="seasons"><label>Name<input name="name" maxlength="150" value="Sindhi Premier League"></label><label>Season number<input type="number" name="season" min="1" required></label><label>Start date<input type="date" name="start_date"></label><label>End date<input type="date" name="end_date"></label><label>Venue<input name="venue" maxlength="180" value="Ulhasnagar"></label><label class="admin-wide">Description<textarea name="description" rows="3" maxlength="2000"></textarea></label><label class="check-label"><input type="checkbox" name="is_current" value="true"> Current season</label><button class="btn btn-gold" type="submit">Add season</button></form></details>
    <div class="admin-record-list"><% records.forEach(t=>{ %><details class="admin-record-card"><summary><strong>Season <%= t.season %></strong><span><%= t.name %><%= t.is_current?' · Current':'' %></span></summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="seasons"><input type="hidden" name="id" value="<%= t.id %>"><label>Name<input name="name" maxlength="150" value="<%= t.name %>"></label><label>Season number<input type="number" name="season" min="1" value="<%= t.season %>" required></label><label>Start date<input type="date" name="start_date" value="<%= t.start_date||'' %>"></label><label>End date<input type="date" name="end_date" value="<%= t.end_date||'' %>"></label><label>Venue<input name="venue" maxlength="180" value="<%= t.venue||'' %>"></label><label class="admin-wide">Description<textarea name="description" rows="3" maxlength="2000"><%= t.description||'' %></textarea></label><label class="check-label"><input type="checkbox" name="is_current" value="true"<%= t.is_current?' checked':'' %>> Current season</label><button class="btn btn-outline-dark" type="submit">Save season</button></form></details><% }) %></div>
  <% } else if(section==='teams'){ %>
    <details class="admin-create-box" open><summary>Add a team</summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="teams"><label>Season<select name="tournament_id" required><% tournaments.forEach(t=>{ %><option value="<%= t.id %>">Season <%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Team name<input name="name" maxlength="120" required></label><label>Short name<input name="short_name" maxlength="20"></label><label>Primary colour<input type="color" name="primary_colour" value="#d9a441"></label><label class="admin-wide">Logo path (optional)<input name="logo" maxlength="255" placeholder="team_logos/logo.png"></label><button class="btn btn-gold" type="submit">Add team</button></form></details>
    <div class="admin-record-list"><% records.forEach(t=>{ %><details class="admin-record-card"><summary><strong><%= t.name %></strong><span>Season <%= t.season %> · <%= t.short_name||'No short name' %></span></summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="teams"><input type="hidden" name="id" value="<%= t.id %>"><label>Season<select name="tournament_id"><% tournaments.forEach(season=>{ %><option value="<%= season.id %>"<%= t.tournament_id===season.id?' selected':'' %>>Season <%= season.season %> · <%= season.name %></option><% }) %></select></label><label>Team name<input name="name" maxlength="120" value="<%= t.name %>" required></label><label>Short name<input name="short_name" maxlength="20" value="<%= t.short_name||'' %>"></label><label>Primary colour<input type="color" name="primary_colour" value="<%= /^#[0-9a-f]{6}$/i.test(t.primary_colour||'')?t.primary_colour:'#d9a441' %>"></label><label class="admin-wide">Logo path<input name="logo" maxlength="255" value="<%= t.logo||'' %>"></label><button class="btn btn-outline-dark" type="submit">Save team</button></form></details><% }) %></div>
  <% } else if(section==='players'){ %>
    <details class="admin-create-box" open><summary>Add a player</summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="players"><label>Player name<input name="name" maxlength="120" required></label><label>City<input name="city" maxlength="100"></label><label class="admin-wide">Photo path (optional)<input name="photo" maxlength="255" placeholder="player_photos/photo.jpg"></label><label class="admin-wide">Teams<select name="teams" multiple size="5"><% teams.forEach(t=>{ %><option value="<%= t.id %>">Season <%= t.season %> · <%= t.name %></option><% }) %></select><small>Use Ctrl or Command to choose more than one team.</small></label><label class="check-label"><input type="checkbox" name="is_active" value="true" checked> Active profile</label><button class="btn btn-gold" type="submit">Add player</button></form></details>
    <div class="admin-record-list"><% records.forEach(p=>{ const selectedTeamIds=String(p.team_ids||'').split(','); %><details class="admin-record-card"><summary><strong><%= p.name %></strong><span><%= p.city||'City not set' %> · <%= selectedTeamIds.length&&selectedTeamIds[0]?'Team assigned':'No team assigned' %><%= p.is_active?'':' · Inactive' %></span></summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="players"><input type="hidden" name="id" value="<%= p.id %>"><label>Player name<input name="name" maxlength="120" value="<%= p.name %>" required></label><label>City<input name="city" maxlength="100" value="<%= p.city||'' %>"></label><label class="admin-wide">Photo path<input name="photo" maxlength="255" value="<%= p.photo||'' %>"></label><label class="admin-wide">Teams<select name="teams" multiple size="5"><% teams.forEach(t=>{ %><option value="<%= t.id %>"<%= selectedTeamIds.includes(String(t.id))?' selected':'' %>>Season <%= t.season %> · <%= t.name %></option><% }) %></select><small>Use Ctrl or Command to choose more than one team.</small></label><label class="check-label"><input type="checkbox" name="is_active" value="true"<%= p.is_active?' checked':'' %>> Active profile</label><button class="btn btn-outline-dark" type="submit">Save player</button></form></details><% }) %></div>
  <% } else if(section==='matches'){ %>
    <details class="admin-create-box" open><summary>Add a scheduled fixture</summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="matches"><label>Season<select name="tournament_id" required><% tournaments.forEach(t=>{ %><option value="<%= t.id %>">Season <%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Date<input type="date" name="date"></label><label>Team A<select name="team_a_id" required><% teams.forEach(t=>{ %><option value="<%= t.id %>">S<%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Team B<select name="team_b_id" required><% teams.forEach(t=>{ %><option value="<%= t.id %>">S<%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Stage<input name="stage" maxlength="80" placeholder="League match"></label><label>Ground<input name="ground" maxlength="180" value="Ulhasnagar"></label><button class="btn btn-gold" type="submit">Add fixture</button></form></details>
    <div class="admin-record-list"><% records.forEach(m=>{ %><details class="admin-record-card"><summary><strong><%= m.team_a.name %> vs <%= m.team_b.name %></strong><span>Season <%= m.tournament.season %> · <%= m.stage||'League match' %> · <%= statusLabel(m.status) %></span></summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="matches"><input type="hidden" name="id" value="<%= m.id %>"><label>Season<select name="tournament_id"><% tournaments.forEach(t=>{ %><option value="<%= t.id %>"<%= m.tournament_id===t.id?' selected':'' %>>Season <%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Date<input type="date" name="date" value="<%= m.date||'' %>"></label><label>Team A<select name="team_a_id"><% teams.forEach(t=>{ %><option value="<%= t.id %>"<%= m.team_a.id===t.id?' selected':'' %>>S<%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Team B<select name="team_b_id"><% teams.forEach(t=>{ %><option value="<%= t.id %>"<%= m.team_b.id===t.id?' selected':'' %>>S<%= t.season %> · <%= t.name %></option><% }) %></select></label><label>Stage<input name="stage" maxlength="80" value="<%= m.stage||'' %>"></label><label>Ground<input name="ground" maxlength="180" value="<%= m.ground||'' %>"></label><label>Toss<input name="toss" maxlength="255" value="<%= m.toss||'' %>"></label><label>CricHeroes link<input type="url" name="cricheroes_url" value="<%= m.cricheroes_url||'' %>"></label><label>Status<select name="status"><% ['scheduled','live','completed','abandoned'].forEach(state=>{ %><option value="<%= state %>"<%= m.status===state?' selected':'' %>><%= statusLabel(state) %><%= state==='live'?' · use scoring page to finish':'' %></option><% }) %></select></label><label>Winner<select name="winner_id"><option value="">No winner recorded</option><option value="<%= m.team_a.id %>"<%= m.winner?.id===m.team_a.id?' selected':'' %>><%= m.team_a.name %></option><option value="<%= m.team_b.id %>"<%= m.winner?.id===m.team_b.id?' selected':'' %>><%= m.team_b.name %></option></select></label><label class="admin-wide">Result text<input name="result_text" maxlength="255" value="<%= m.result_text||'' %>"></label><button class="btn btn-outline-dark" type="submit">Save fixture</button><% if(m.status==='live'){ %><a class="btn btn-gold" href="/matches/<%= m.id %>/live/">Open scorer</a><% } %></form></details><% }) %></div>
  <% } else if(section==='sponsors'){ %>
    <details class="admin-create-box" open><summary>Add a sponsor</summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="sponsors"><label>Name<input name="name" maxlength="150" required></label><label>Category<select name="category"><option value="title">Title sponsor</option><option value="associate">Associate sponsor</option></select></label><label class="admin-wide">Logo path (optional)<input name="logo" maxlength="255" placeholder="sponsor_logos/logo.webp"></label><label class="admin-wide">Website<input type="url" name="website" maxlength="500"></label><button class="btn btn-gold" type="submit">Add sponsor</button></form></details>
    <div class="admin-record-list"><% records.forEach(s=>{ %><details class="admin-record-card"><summary><strong><%= s.name %></strong><span><%= s.category_display %></span></summary><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="sponsors"><input type="hidden" name="id" value="<%= s.id %>"><label>Name<input name="name" maxlength="150" value="<%= s.name %>" required></label><label>Category<select name="category"><option value="title"<%= s.category==='title'?' selected':'' %>>Title sponsor</option><option value="associate"<%= s.category==='associate'?' selected':'' %>>Associate sponsor</option></select></label><label class="admin-wide">Logo path<input name="logo" maxlength="255" value="<%= s.logo||'' %>"></label><label class="admin-wide">Website<input type="url" name="website" maxlength="500" value="<%= s.website||'' %>"></label><button class="btn btn-outline-dark" type="submit">Save sponsor</button></form></details><% }) %></div>
  <% } else if(section==='access'){ %>
    <section class="access-assignment-panel"><div><p class="eyebrow">ACCOUNT SETUP</p><h3>Create an SPL account</h3><p>Create an account for a staff member, player, or team owner. Team Owner accounts must be assigned to a team.</p></div><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="access"><input type="hidden" name="access_action" value="account_create"><label>Username<input name="username" minlength="3" maxlength="32" pattern="[A-Za-z0-9._-]+" autocomplete="username" required></label><label>Email<input type="email" name="email" maxlength="254" autocomplete="email" required></label><label>Temporary password<input type="password" name="password" minlength="12" maxlength="1024" autocomplete="new-password" required></label><label>Role<select name="role_key" required><% accessRoles.forEach(role=>{ %><option value="<%= role.role_key %>"><%= role.display_name %></option><% }) %></select></label><label class="admin-wide">Team for Team Owner role<select name="team_id"><option value="">Select a team when assigning Team Owner</option><% teams.forEach(team=>{ %><option value="<%= team.id %>">Season <%= team.season %> · <%= team.name %></option><% }) %></select></label><button class="btn btn-gold" type="submit">Create account</button></form></section><section class="access-assignment-panel"><div><p class="eyebrow">ROLE ASSIGNMENTS</p><h3>Grant a role to an existing account</h3><p>Only existing SPL accounts can receive dashboard access. Team owners must be connected to a specific team.</p></div><form method="post" class="admin-record-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="access"><input type="hidden" name="access_action" value="grant"><label>Account<select name="user_id" required><% records.filter(account=>account.is_active).forEach(account=>{ %><option value="<%= account.id %>"><%= account.username %> · <%= account.email||'No email recorded' %></option><% }) %></select></label><label>Role<select name="role_key" required><% accessRoles.forEach(role=>{ %><option value="<%= role.role_key %>"><%= role.display_name %></option><% }) %></select></label><label class="admin-wide">Team for Team Owner role<select name="team_id"><option value="">Select a team when assigning Team Owner</option><% teams.forEach(team=>{ %><option value="<%= team.id %>">Season <%= team.season %> · <%= team.name %></option><% }) %></select></label><button class="btn btn-gold" type="submit">Assign access</button></form></section>
    <section class="access-table-section"><div class="section-head"><div><p class="eyebrow">STAFF AND PLAYER ACCESS</p><h2>Assigned roles</h2></div></div><div class="table-wrap"><table class="score-table"><thead><tr><th>Account</th><th>Role</th><th>Assigned by</th><th></th></tr></thead><tbody><% if(accessAssignments.length){ accessAssignments.forEach(assignment=>{ %><tr><td><strong><%= assignment.username %></strong></td><td><%= assignment.display_name %></td><td><%= assignment.granted_by_id||'System' %></td><td><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="access"><input type="hidden" name="access_action" value="revoke"><input type="hidden" name="user_id" value="<%= assignment.user_id %>"><input type="hidden" name="role_key" value="<%= assignment.role_key %>"><button class="text-link" type="submit">Remove role</button></form></td></tr><% })}else{ %><tr><td colspan="4">No manually assigned roles. Existing Django superuser/staff access remains compatible.</td></tr><% } %></tbody></table></div></section>
    <section class="access-table-section"><div class="section-head"><div><p class="eyebrow">TEAM OWNERS</p><h2>Team assignments</h2></div></div><div class="table-wrap"><table class="score-table"><thead><tr><th>Account</th><th>Team</th><th>Season</th><th></th></tr></thead><tbody><% if(teamOwnerAssignments.length){ teamOwnerAssignments.forEach(owner=>{ %><tr><td><strong><%= owner.username %></strong></td><td><%= owner.team_name %></td><td><%= owner.season %></td><td><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="access"><input type="hidden" name="access_action" value="revoke"><input type="hidden" name="user_id" value="<%= owner.user_id %>"><input type="hidden" name="role_key" value="team_owner"><input type="hidden" name="team_id" value="<%= owner.team_id %>"><button class="text-link" type="submit">Remove team</button></form></td></tr><% })}else{ %><tr><td colspan="4">No team owners are assigned.</td></tr><% } %></tbody></table></div></section>
    <section class="access-table-section"><div class="section-head"><div><p class="eyebrow">ACTIVE ACCOUNTS</p><h2>Account directory</h2></div></div><div class="table-wrap"><table class="score-table"><thead><tr><th>Username</th><th>Email</th><th>Account state</th><th>Access</th></tr></thead><tbody><% records.forEach(account=>{ const assigned=String(account.role_keys||'').split(',').filter(Boolean); %><tr><td><strong><%= account.username %></strong></td><td><%= account.email||'—' %></td><td><%= account.is_active?'Active':'Disabled' %></td><td><%= account.is_superuser?'Super Admin (source account)':assigned.length?assigned.join(', '):account.is_staff?'Organiser (legacy staff)':'Spectator' %></td></tr><% }) %></tbody></table></div></section>
  <% } else { %>
    <div class="admin-record-list"><% records.forEach(e=>{ %><article class="admin-enquiry-card"><div class="admin-enquiry-head"><div><strong><%= e.subject||'General enquiry' %></strong><span><%= e.name %> · <%= e.email %><%= e.phone?' · '+e.phone:'' %></span></div><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="entity" value="enquiries"><input type="hidden" name="id" value="<%= e.id %>"><input type="hidden" name="is_resolved" value="<%= e.is_resolved?'false':'true' %>"><button class="btn <%= e.is_resolved?'btn-outline-dark':'btn-gold' %>" type="submit"><%= e.is_resolved?'Reopen':'Mark resolved' %></button></form></div><p><%= e.message %></p><small><%= e.created_at %> · <%= e.is_resolved?'Resolved':'Open' %></small></article><% }) %></div>
  <% } %>
  <% if(pageCount>1){ %><nav class="admin-pagination" aria-label="Record pages"><% if(pageNumber>1){ %><a class="btn btn-outline-dark" href="/organiser/manage/?section=<%= section %>&amp;page=<%= pageNumber-1 %>&amp;q=<%= encodeURIComponent(search) %>">← Previous</a><% } %><span>Page <%= pageNumber %> of <%= pageCount %></span><% if(pageNumber<pageCount){ %><a class="btn btn-outline-dark" href="/organiser/manage/?section=<%= section %>&amp;page=<%= pageNumber+1 %>&amp;q=<%= encodeURIComponent(search) %>">Next →</a><% } %></nav><% } %>
  <p class="form-note admin-back-links"><a href="/organiser/">← Organiser desk</a> · <a href="/organiser/auction/">Auction controls</a> · <a href="/matches/start/">Start a match</a></p>
</section>
<%- include('../partials/footer') %>
