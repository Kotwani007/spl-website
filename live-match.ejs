<%- include('../partials/header') %>
<section class="page-hero live-score-hero"><p class="eyebrow"><% if(match.status==='live'){ %><span class="live-dot"></span> LIVE SCORING<% }else{ %><%= match.status_display.toUpperCase() %> MATCH<% } %> · SEASON <%= match.tournament.season %></p><h1><%= match.team_a.name %> <em>vs</em> <%= match.team_b.name %></h1><p class="lead"><%= match.ground||'Ulhasnagar' %> · <%= date(match.date) %></p></section><section class="section"><div class="live-score-layout" id="live-score-page" data-refresh-url="/matches/<%= match.id %>/live/?fragment=score" data-refresh-active="<%= match.status==='live'?'true':'false' %>"><div><div id="live-scoreboard-region"><%- include('../partials/live-scoreboard', {match, innings_list, current_innings}) %></div>
<% if(user.is_staff&&match.status==='live'&&current_innings){ %><div class="live-scoring-form"><p class="eyebrow">ORGANISER SCORING PANEL</p><h2>Record next delivery</h2><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= auctionNonce %>"><input type="hidden" name="action" value="ball"><label>Batter<select name="batter" required><option value="">Select batter</option><% players.filter(p=>p.teams.some(t=>t.id===current_innings.batting_team_id)).forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><label>Bowler<select name="bowler" required><option value="">Select bowler</option><% players.filter(p=>p.teams.some(t=>t.id===current_innings.bowling_team_id)).forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><div class="score-input-grid"><label>Runs off bat<select name="batter_runs"><% for(let i=0;i<=6;i++){ %><option><%= i %></option><% } %></select></label><label>Extra runs<select name="extra_runs"><% for(let i=0;i<=4;i++){ %><option><%= i %></option><% } %></select></label></div><label>Extra type<select name="extra_type"><option value="none">None</option><option value="wide">Wide</option><option value="no_ball">No-ball</option><option value="bye">Bye</option><option value="leg_bye">Leg-bye</option></select></label><label>Wicket<select name="dismissal_type"><option value="">No wicket</option><option value="bowled">Bowled</option><option value="caught">Caught</option><option value="lbw">LBW</option><option value="run_out">Run out</option><option value="stumped">Stumped</option><option value="hit_wicket">Hit wicket</option><option value="caught_and_bowled">Caught &amp; bowled</option></select></label><label>Dismissed player<select name="dismissed_player"><option value="">Select if wicket</option><% players.filter(p=>p.teams.some(t=>t.id===current_innings.batting_team_id)).forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><label>Fielder (for catch/run-out)<select name="fielder"><option value="">Select fielder if applicable</option><% players.filter(p=>p.teams.some(t=>t.id===current_innings.bowling_team_id)).forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><button class="btn btn-gold" type="submit">＋ Add delivery</button></form><div class="live-actions"><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="undo"><button class="btn btn-outline-dark" type="submit">Undo last delivery</button></form><form method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="end_innings"><button class="btn btn-outline-dark" type="submit">End innings / Start next</button></form><form method="post" onsubmit="return confirm('Finish this match?')"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="action" value="finish"><button class="btn btn-dark" type="submit">Finish match</button></form></div></div><% }else if(match.status==='completed'){ %><div class="empty-state">This match has been marked completed.</div><% } %></div>
<div id="live-deliveries-region"><%- include('../partials/live-deliveries', {innings_list}) %></div></div></div><p><a class="text-link" href="/matches/<%= match.id %>/">← Match scorecard</a></p></section>
<%- include('../partials/footer') %>
