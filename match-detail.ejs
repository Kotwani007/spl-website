<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">SEASON <%= match.tournament.season %> · <%= match.stage %></p><h1><%= match.team_a.name %> <em>vs</em> <%= match.team_b.name %></h1><p class="lead"><%= match.date?date(match.date):'Date TBA' %> · <%= match.ground||'' %></p></section>
<section class="section">
<% if(match.status==='live'){ %><div class="live-score-banner\"><div><span class="live-dot"></span> LIVE MATCH</div><p>Follow the score and latest deliveries as the match progresses.</p><a class="btn btn-gold" href="/matches/<%= match.id %>/live/"><%= user.is_staff?'Open live scoring':'View live score' %> →</a></div><% } %>
<% if(live_innings.length){ %><div class="live-innings-summary"><% live_innings.forEach(inn=>{ %><div><small>INNINGS <%= inn.innings_number %> · <%= inn.batting_team.name %></small><b><%= inn.total_runs %>/<%= inn.wickets %></b><span><%= inn.legal_balls %> legal balls</span></div><% }) %></div><% } %>
<div class="score-hero"><% if(match.score_summaries.length){match.score_summaries.forEach((score,index)=>{ %><div><span><%= score.team %></span><b><%= score.score %></b><small><%= score.overs %> overs</small></div><% if(index<match.score_summaries.length-1){ %><strong>VS</strong><% } %><% })}else{ %><div><span><%= match.team_a.name %></span><b><%= match.score_a.score %></b><small><%= match.score_a.overs %> overs</small></div><strong>VS</strong><div><span><%= match.team_b.name %></span><b><%= match.score_b.score %></b><small><%= match.score_b.overs %> overs</small></div><% } %></div>
<h2><%= match.result_text||'Result not recorded' %></h2><p><b>Toss:</b> <%= match.toss||'' %></p>
<% const scoreInnings=match.full_scorecard?.innings||[]; if(scoreInnings.length){scoreInnings.forEach((inn,index)=>{ %><section class="innings-panel"><div class="section-head"><div><p class="eyebrow">INNINGS <%= index+1 %></p><h2><%= inn.team %> · <%= inn.runs %>/<%= inn.wickets %></h2></div><span><%= inn.overs %> overs</span></div><h3>Batting</h3><div class="table-wrap"><table class="score-table"><thead><tr><th>Batter</th><th>Dismissal</th><th>R</th><th>B</th><th>4s</th><th>6s</th><th>SR</th></tr></thead><tbody><% if(inn.batting?.length){inn.batting.forEach(b=>{ %><tr><td><%= b.name %></td><td><%= b.status||'—' %></td><td><%= b.runs %></td><td><%= b.balls %></td><td><%= b.fours %></td><td><%= b.sixes %></td><td><%= b.strike_rate %></td></tr><% })}else{ %><tr><td colspan="7">Batting figures not available.</td></tr><% } %></tbody></table></div>
<% if(inn.extras){ %><p><b>Extras:</b> <% Object.entries(inn.extras).forEach(([key,value],i)=>{ %><%= key %> <%= value %><%= i<Object.keys(inn.extras).length-1?', ':'' %><% }) %></p><% } %><% if(inn.to_bat?.length){ %><p><b>Yet to bat:</b> <%= inn.to_bat.join(', ') %></p><% } %><% if(inn.fall_of_wickets){ %><p><b>Fall of wickets:</b> <%= inn.fall_of_wickets %></p><% } %>
<h3>Bowling</h3><div class="table-wrap"><table class="score-table"><thead><tr><th>Bowler</th><th>O</th><th>M</th><th>R</th><th>W</th><th>Dots</th><th>4s</th><th>6s</th><th>WD</th><th>NB</th><th>Eco</th></tr></thead><tbody><% if(inn.bowling?.length){inn.bowling.forEach(b=>{ %><tr><td><%= b.name %></td><td><%= b.overs %></td><td><%= b.maidens %></td><td><%= b.runs %></td><td><%= b.wickets %></td><td><%= b.dot_balls %></td><td><%= b.fours_conceded %></td><td><%= b.sixes_conceded %></td><td><%= b.wides %></td><td><%= b.no_balls %></td><td><%= b.economy %></td></tr><% })}else{ %><tr><td colspan="11">Bowling figures not available.</td></tr><% } %></tbody></table></div></section><% })}else{ %>
<div class="two-col"><div class="data-panel"><h3>Top batting performances</h3><% if(match.best_batters.length){match.best_batters.forEach(x=>{ %><p><%= x.name %> <b><%= x.runs %> runs</b></p><% })}else{ %><p>Not available.</p><% } %></div><div class="data-panel"><h3>Top bowling performances</h3><% if(match.best_bowlers.length){match.best_bowlers.forEach(x=>{ %><p><%= x.name %> <b><%= x.wickets %> wickets</b></p><% })}else{ %><p>Not available.</p><% } %></div></div><% } %>
<% if(match.scorecard_text){ %><details class="score-text"><summary>View original extracted scorecard text</summary><pre><%= match.scorecard_text %></pre></details><% } %>
</section><%- include('../partials/footer') %>
