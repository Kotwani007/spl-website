<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">GET IN TOUCH</p><h1>Contact the league.</h1><p class="lead">Sponsorship, team registration and general enquiries.</p></section><section class="section"><form method="post" class="contact-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><% if(Object.keys(formErrors||{}).length){ %><div class="notice full">Please check your details and try again.</div><% } %><label>Your name<input required name="name" maxlength="120" value="<%= formValues.name||'' %>"></label><label>Email address<input required type="email" name="email" value="<%= formValues.email||'' %>"></label><label>Phone / WhatsApp<input name="phone" value="<%= formValues.phone||'' %>"></label><label>Subject<input name="subject" value="<%= formValues.subject||'' %>"></label><label class="full">Message<textarea required name="message" rows="5"><%= formValues.message||'' %></textarea></label><button class="btn btn-gold">Send enquiry</button><p class="form-note">Enquiries are saved in the organiser database. Email notifications require Gmail SMTP setup.</p></form></section>
<%- include('../partials/footer') %>
