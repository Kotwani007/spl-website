<%- include('../partials/header') %>
<section class="page-hero"><p class="eyebrow">THE LINE-UP</p><h1>Teams of SPL</h1><p class="lead">Choose a team to explore its season squad and player profiles.</p></section>
<section class="section"><form class="filter-bar" method="get"><label>Season <select name="season"><option value="">All seasons</option><% seasons.forEach(s=>{ %><option value="<%= s.season %>"<%= Number(selectedSeason)===s.season?' selected':'' %>>Season <%= s.season %></option><% }) %></select></label><button class="btn btn-gold">Apply</button></form><div class="card-grid"><% if(teams.length){teams.forEach(team=>{ %><a class="team-card team-link-card" href="/teams/<%= team.id %>/"><div class="team-emblem"><% if(mediaUrl(team.logo)){ %><img src="<%= mediaUrl(team.logo) %>" alt="<%= team.name %>"><% }else{ %><%= team.short_name||'SPL' %><% } %></div><p class="eyebrow">SEASON <%= team.tournament.season %></p><h3><%= team.name %></h3><p><%= team.player_count %> registered players · <%= team.matches_played_count %> player-match appearances</p><span class="team-card-cta">View squad <b>→</b></span></a><% })}else{ %><div class="empty-state">Teams will appear here once added by the organisers.</div><% } %></div></section>
<%- include('../partials/footer') %>
